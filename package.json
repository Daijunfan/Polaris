{
  "name": "polaris-mentor",
  "private": true,
  "version": "5.0.0",
  "description": "北极星 Polaris：读研选导师的 AI 参谋，真实评价、风险标签、导师对决与套磁",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "npm start",
    "desktop:dev": "npm run build && electron .",
    "desktop:start": "npm run build && electron .",
    "desktop:icons": "node scripts/generate-icons.mjs",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:build:mac": "npm run build && electron-builder --mac --publish never",
    "desktop:build:win": "npm run build && electron-builder --win --publish never",
    "cli": "node bin/mentor.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:seal": "node scripts/seal-data.mjs",
    "data:import": "node -e \"const {spawnSync}=require('node:child_process');const env={...process.env,PYTHONDONTWRITEBYTECODE:'1'};const cands=process.platform==='win32'?[['py',['-3','-B']],['python',['-B']],['python3',['-B']]]:[['python3',['-B']],['python',['-B']]];const found=cands.find(([c])=>{const r=spawnSync(c,c==='py'?['-3','--version']:['--version'],{encoding:'utf8',stdio:'pipe',windowsHide:true});return r.status===0&&/Python\\s+3\\./i.test((r.stdout||'')+(r.stderr||''))});if(!found){console.error('未检测到可用的 Python 3（Windows 请安装 Python 3 并关闭应用执行别名；macOS/Linux 请安装 python3）。');process.exit(1)}const res=spawnSync(found[0],[...found[1],'scripts/import-pdf-reviews.py',...process.argv.slice(1)],{stdio:'inherit',env});process.exit(res.status??1)\" --",
    "data:crawl": "node scripts/crawl-web.mjs",
    "vault:check": "node scripts/check-vault-hygiene.mjs",
    "test": "node --test tests/server.test.mjs tests/tools.test.mjs tests/web.test.mjs tests/trusted-answer.test.mjs tests/search.test.mjs tests/delivery.test.mjs tests/pdf-import.test.mjs tests/stipend-display.test.mjs tests/review-refresh.test.mjs tests/workbench.test.mjs tests/insights.test.mjs tests/cli-polish.test.mjs tests/multi-college-dossier.test.mjs tests/extreme-polish.test.mjs tests/quick-search-filters.test.mjs tests/vault-security.test.mjs tests/cross-platform.test.mjs tests/presentation.test.mjs tests/export.test.mjs tests/export-api-and-cli.test.mjs tests/desktop-and-config.test.mjs tests/ui-polish-round1.test.mjs tests/theme.test.mjs",
    "test:e2e": "vite build --outDir .local/ui-test-dist --emptyOutDir && playwright test",
    "test:live": "node --env-file-if-exists=.env scripts/live-smoke.mjs",
    "package": "node scripts/package-release.mjs",
    "launch": "node scripts/start.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "polaris": "bin/mentor.mjs",
    "mentor-buffet": "bin/mentor.mjs"
  },
  "license": "MIT",
  "files": [
    "bin",
    "build",
    "electron",
    "lib",
    "server",
    "src",
    "data/dataset.vault",
    "data/web-profiles.vault",
    "data/web-seeds.vault",
    "data/mentor-notes.vault",
    "data/pdf-reviews.vault",
    "scripts",
    "tests",
    "index.html",
    "vite.config.js",
    "playwright.config.mjs",
    "DATA.md",
    ".env.example",
    ".github",
    "public",
    "docs/TOOLS.md",
    "docs/AGENT.md",
    "docs/RELEASE-CHECKLIST.md",
    "start.cmd",
    "start.command",
    ".gitattributes",
    "docs/POLARIS-5.0.0.md",
    "docs/images/polaris-welcome.png",
    "docs/images/polaris-ranking.png",
    "docs/images/polaris-dossier.png",
    "docs/images/polaris-duel.png",
    "docs/images/polaris-mobile.png",
    "docs/images/polaris-share-card.png"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "docx": "^9.16.0",
    "exceljs": "^4.4.0",
    "lucide-react": "1.31.0",
    "pdfkit": "^0.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-react": "6.0.5",
    "cheerio": "^1.2.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "read-excel-file": "9.3.15",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.polaris.mentor",
    "productName": "Polaris",
    "executableName": "Polaris",
    "asar": true,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "server/**/*",
      "lib/**/*",
      "src/presentation.js",
      "data/*.vault",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!**/node_modules/.cache"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "CFBundleDisplayName": "北极星 Polaris"
      }
    },
    "dmg": {
      "title": "北极星 Polaris ${version}",
      "artifactName": "Polaris-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "北极星 Polaris",
      "artifactName": "Polaris-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Polaris-${version}-win-${arch}-portable.${ext}"
    }
  }
}
