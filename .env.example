# Optional: the app also supports configuring LLM connection in its chat settings.
MENTOR_API_URL=https://api.deepseek.com
MENTOR_API_KEY=
# Or read an existing credential without copying it into this project:
# MENTOR_API_KEY_FILE=/absolute/path/to/key
MENTOR_MODEL=deepseek-chat
PORT=3210
# Required to unlock the AES-256-GCM encrypted mentor vault (data/*.vault):
MENTOR_VAULT_KEY=
# MENTOR_DATA_DIR=/path/to/private/app-data
# Optional override when a provider does not report a model's actual context capacity:
# MENTOR_CONTEXT_TOKENS=32768
